---
export const prerender = false;

import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectFilters from "../components/ProjectFilters.jsx";

const projects = await getCollection("projectsCollection");

// Group projects by category for better organization
const categories = [
  "all",
  "fullstack",
  "infrastructure",
  "web",
  "mobile",
  "devops",
  "ai",
  "other",
];
const statuses = ["all", "completed", "in-progress", "planned"];

// Sort projects by start date (newest first)
const sortedProjects = projects.sort(
  (a, b) =>
    new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime()
);
---

<BaseLayout>
  <main class="min-h-screen bg-white">
    <!-- Hero Section -->
    <section class="max-w-4xl mx-auto px-6 py-20">
      <div class="max-w-2xl">
        <h1 class="text-5xl font-light text-gray-900 leading-tight mb-8">
          My Work
        </h1>
        <p class="text-xl text-gray-600 leading-relaxed mb-12 font-light">
          A collection of projects spanning infrastructure automation,
          full-stack development, and system reliability engineering. Each
          project represents a unique challenge and learning opportunity in
          building scalable, maintainable solutions.
        </p>

        <!-- Stats -->
        <div class="flex flex-wrap gap-8 mb-8">
          <div class="flex flex-col">
            <span class="text-2xl font-light text-gray-900"
              >{projects.length}</span
            >
            <span class="text-sm text-gray-600">Total Projects</span>
          </div>
          <div class="flex flex-col">
            <span class="text-2xl font-light text-gray-900">
              {projects.filter((p) => p.data.status === "completed").length}
            </span>
            <span class="text-sm text-gray-600">Completed</span>
          </div>
          <div class="flex flex-col">
            <span class="text-2xl font-light text-gray-900">
              {projects.filter((p) => p.data.featured).length}
            </span>
            <span class="text-sm text-gray-600">Featured</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section class="bg-gray-50 py-20">
      <div class="max-w-4xl mx-auto px-6">
        <!-- Filters Component -->
        <ProjectFilters
          client:load
          categories={categories}
          statuses={statuses}
          totalProjects={projects.length}
        />

        <!-- Projects Grid -->
        <div id="projects-container" class="space-y-8 mt-8">
          {
            sortedProjects.map((project) => (
              <div
                class="project-item"
                data-category={project.data.category}
                data-status={project.data.status}
                data-featured={project.data.featured}
              >
                <ProjectCard project={project.data} />
              </div>
            ))
          }
        </div>

        <!-- Empty State -->
        <div id="empty-state" class="hidden text-center py-16">
          <div class="text-gray-400 mb-4">
            <svg
              class="w-16 h-16 mx-auto"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1"
                d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-medium text-gray-900 mb-2">
            No projects found
          </h3>
          <p class="text-gray-500">
            Try adjusting your filters to see more projects.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
