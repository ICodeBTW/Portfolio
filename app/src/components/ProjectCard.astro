---
// src/components/ProjectCard.astro
import type { CollectionEntry } from "astro:content";
import CustomImage from "./UI/CustomImage.astro";

interface Props {
  project: CollectionEntry<"projectsCollection">["data"];
}

const { project } = Astro.props;
const {
  title,
  description,
  skills,
  img,
  status,
  links,
  category,
  startDate,
  endDate,
} = project;

// Status colors
const statusColors = {
  completed: "bg-green-100 text-green-800",
  "in-progress": "bg-blue-100 text-blue-800",
  planned: "bg-gray-100 text-gray-800",
};

// Category colors
const categoryColors = {
  web: "bg-purple-100 text-purple-800",
  mobile: "bg-orange-100 text-orange-800",
  devops: "bg-cyan-100 text-cyan-800",
  ai: "bg-pink-100 text-pink-800",
  infrastructure: "bg-indigo-100 text-indigo-800",
  fullstack: "bg-amber-100 text-amber-800",
  other: "bg-gray-100 text-gray-800",
};

// Format date for display
const formatDate = (dateStr: string) => {
  const date = new Date(dateStr);
  return date.toLocaleDateString("en-US", { year: "numeric", month: "short" });
};

// Calculate duration
const getDuration = (start: string, end?: string) => {
  const startDate = new Date(start);
  const endDate = end ? new Date(end) : new Date();
  const months = Math.ceil(
    (endDate.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24 * 30)
  );
  return months === 1 ? "1 month" : `${months} months`;
};
---

<article
  class="bg-white rounded-lg p-8 shadow-sm hover:shadow-md transition-all duration-200 border border-gray-100 group"
>
  <div class="flex flex-col lg:flex-row lg:items-start lg:space-x-8">
    <div class="flex-1">
      <!-- Header -->
      <div class="flex items-start justify-between mb-4">
        <div class="flex-1">
          <h4
            class="text-xl font-medium text-gray-900 mb-2 group-hover:text-gray-700 transition-colors"
          >
            {title}
          </h4>

          <!-- Date and Duration -->
          <div class="flex items-center text-sm text-gray-500 mb-3">
            <time>{formatDate(startDate)}</time>
            {
              endDate && (
                <>
                  <span class="mx-2">–</span>
                  <time>{formatDate(endDate)}</time>
                </>
              )
            }
            <span class="mx-2">•</span>
            <span>{getDuration(startDate, endDate)}</span>
          </div>
        </div>

        <!-- Status and Category Badges -->
        <div class="flex gap-2 ml-4 flex-shrink-0">
          <span
            class={`px-3 py-1 rounded-full text-xs font-medium ${statusColors[status]}`}
          >
            {status.replace("-", " ").toUpperCase()}
          </span>
          <span
            class={`px-3 py-1 rounded-full text-xs font-medium ${categoryColors[category]}`}
          >
            {category.toUpperCase()}
          </span>
        </div>
      </div>

      <!-- Description -->
      <p class="text-gray-600 leading-relaxed mb-6 text-sm lg:text-base">
        {description}
      </p>

      <!-- Skills -->
      <div class="mb-6">
        <h5 class="text-sm font-medium text-gray-900 mb-3">
          Technologies & Skills
        </h5>
        <div class="flex flex-wrap gap-2">
          {
            skills.map((skill: string) => (
              <span class="bg-gray-50 text-gray-700 px-3 py-1 rounded-full text-xs font-medium border border-gray-200 hover:bg-gray-100 transition-colors">
                {skill}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Links -->
      {
        links && (
          <div class="flex flex-wrap gap-3">
            {links.github && (
              <a
                href={links.github.href || "#"}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View source code"
                class={`inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg transition-all ${
                  links.github.disabled
                    ? "bg-gray-100 text-gray-400 cursor-not-allowed"
                    : "bg-gray-900 text-white hover:bg-gray-800 hover:shadow-lg"
                }`}
                style={links.github.disabled ? "pointer-events: none;" : ""}
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                </svg>
                <span>
                  {links.github.disabled ? "Private Repository" : "View Code"}
                </span>
              </a>
            )}

            {links.live && !links.live.disabled && (
              <a
                href={links.live.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View live project"
                class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg bg-blue-600 text-white hover:bg-blue-700 hover:shadow-lg transition-all"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  />
                </svg>
                <span>Live Demo</span>
              </a>
            )}

            {links.demo && !links.demo.disabled && (
              <a
                href={links.demo.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View demo"
                class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 hover:border-gray-400 transition-all"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
                <span>View Demo</span>
              </a>
            )}
          </div>
        )
      }
    </div>

    <!-- Project Image/Preview -->
    <div
      class="w-full lg:w-64 h-40 mt-6 lg:mt-0 rounded-lg overflow-hidden bg-gray-50 flex items-center justify-center border border-gray-200 group-hover:border-gray-300 transition-colors"
    >
      {
        img ? (
          <div class="relative w-full h-full">
            <CustomImage
              classes="w-full h-full object-contain group-hover:scale-105 transition-transform duration-200"
              src={img}
              alt={`${title} preview`}
              width="300"
              height="200"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-200" />
          </div>
        ) : (
          <div class="text-center p-6">
            <svg
              class="w-12 h-12 text-gray-300 mx-auto mb-3"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
            <p class="text-gray-400 text-sm">Project Preview</p>
          </div>
        )
      }
    </div>
  </div>
</article>
